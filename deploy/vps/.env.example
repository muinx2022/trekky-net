COMPOSE_PROJECT_NAME=trekky-net
DOCKERHUB_USERNAME=muinx2022
DOCKERHUB_TOKEN=
API_IMAGE=docker.io/muinx2022/trekky-net-api:latest
WEB_IMAGE=docker.io/muinx2022/trekky-net-web:latest

DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=trekky.net,www.trekky.net,api.trekky.net,localhost,127.0.0.1
DJANGO_CORS_ALLOW_ALL=false
DJANGO_CORS_ALLOWED_ORIGINS=https://trekky.net,https://www.trekky.net
DJANGO_CSRF_TRUSTED_ORIGINS=https://trekky.net,https://www.trekky.net,https://api.trekky.net
DJANGO_TIME_ZONE=Asia/Saigon
FRONTEND_URL=https://trekky.net
GOOGLE_REDIRECT_URI=https://api.trekky.net/api/v1/auth/google/callback/

DB_ENGINE=django.db.backends.postgresql
DB_NAME=trekky_net
DB_USER=trekky_net
DB_PASSWORD=change-me
DB_HOST=postgres
DB_PORT=5432

POSTGRES_DB=trekky_net
POSTGRES_USER=trekky_net
POSTGRES_PASSWORD=change-me

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_API_KEY=change-me
MEILI_MASTER_KEY=change-me

UPLOAD_PROVIDER=local
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
CLOUDINARY_SECURE=true

NEXT_PUBLIC_API_URL=https://api.trekky.net
NEXT_PUBLIC_SITE_URL=https://trekky.net
NEXT_PUBLIC_BASE_URL=https://trekky.net
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

GOOGLE_IMAGE_SEARCH_API_KEY=
GOOGLE_IMAGE_SEARCH_ENGINE_ID=
PEXELS_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

SYNC_STRAPI_ON_DEPLOY=false
STRAPI_SYNC_HOST=trekky-postgres
STRAPI_SYNC_PORT=5432
STRAPI_SYNC_DB=trekky
STRAPI_SYNC_USER=trekky
STRAPI_SYNC_PASSWORD=
STRAPI_SYNC_SSLMODE=prefer
STRAPI_SYNC_DOWNLOAD_MEDIA=true
STRAPI_SYNC_MEDIA_TIMEOUT=30
